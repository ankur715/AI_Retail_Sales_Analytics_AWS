# Copy to .env and fill in from `terraform output`. .env is gitignored.

# dev | prod -- picks the Redshift database (retail_<env>) and S3 prefix (<env>/)
RETAIL_ENV=dev

# --- AWS (credentials come from the profile, not this file) ---
AWS_PROFILE=retail-pipeline
AWS_REGION=us-east-1
S3_BUCKET=                      # terraform output: s3_bucket

# --- Redshift Serverless ---
REDSHIFT_HOST=                  # terraform output: redshift_endpoint
REDSHIFT_PORT=5439
REDSHIFT_USER=admin
REDSHIFT_PASSWORD=
REDSHIFT_IAM_ROLE_ARN=          # terraform output: redshift_copy_role_arn

# --- Mock retailer API (uvicorn mock_api.main:app --port 9100) ---
RETAILER_API_URL=http://localhost:9100
RETAILER_API_TOKEN=local-dev-token

DEFAULT_LOOKBACK_WEEKS=5
