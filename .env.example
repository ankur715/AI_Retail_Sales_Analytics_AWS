# Copy to .env and fill in from `terraform output`. .env is gitignored.

# dev | prod -- picks the Redshift database (retail_<env>) and S3 prefix (<env>/)
RETAIL_ENV=dev

# --- AWS (credentials come from the profile, not this file) ---
AWS_PROFILE=retail-pipeline
AWS_REGION=us-east-1
S3_BUCKET=                      # terraform output: s3_bucket

# --- Redshift Serverless ---
REDSHIFT_HOST=                  # terraform output: redshift_endpoint
REDSHIFT_PORT=5439
REDSHIFT_USER=admin
REDSHIFT_PASSWORD=
REDSHIFT_IAM_ROLE_ARN=          # terraform output: redshift_copy_role_arn

# --- Mock retailer API (uvicorn mock_api.main:app --port 9100) ---
RETAILER_API_URL=http://localhost:9100
RETAILER_API_TOKEN=local-dev-token

DEFAULT_LOOKBACK_WEEKS=5

# --- Analytics chatbot (chatbot/) ---
LLM_PROVIDER=bedrock            # bedrock (Claude, AWS credentials) | gemini (Google API key)
# Bedrock: needs model access in the Bedrock console + the chatbot-bedrock-invoke IAM policy (Terraform).
# This account can call Claude Haiku 4.5 through its inference profile on bedrock-runtime:
BEDROCK_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0   # default in code: claude-opus-5-5
LLM_BEDROCK_ENDPOINT=runtime    # runtime for inference profiles; mantle for the newest models
# Gemini (same as Web_App); the free tier allows ~20 requests/day/model:
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
CHAT_REDSHIFT_USER=chat_reader  # read-only user, created by `python -m chatbot.setup_reader`
CHAT_REDSHIFT_PASSWORD=         # 8-64 chars, upper + lower + digit

# --- Pipeline Triage Agent (triage/) -- runs on Bedrock whenever LLM_PROVIDER is not none ---
TRIAGE_MODEL=nova-lite          # nova-lite (default) | claude-haiku | full Bedrock model id / profile
TRIAGE_MAX_STEPS=8              # model calls per triage run
TRIAGE_MAX_TOKENS=40000         # input + output tokens per triage run
TRIAGE_REDSHIFT_USER=triage_reader   # read-only user, created by `python -m triage.setup_reader`
TRIAGE_REDSHIFT_PASSWORD=       # 8-64 chars, upper + lower + digit
